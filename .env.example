# Copy to .env.local for local dev. On Vercel, add these under Project Settings > Environment Variables.
# Never commit real keys. At least one of the two model keys is required.

# DeepSeek (https://platform.deepseek.com/api_keys) — pay-as-you-go
DEEPSEEK_API_KEY=

# Google AI Studio (https://aistudio.google.com/apikey) — enables Gemini, web research and PDF embeddings
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Tavily web search (https://app.tavily.com), free tier 1,000 credits/month.
# Used first for "web research"; Gemini + Google Search is the fallback.
TAVILY_API_KEY=

# Optional: require this code before the public deployment will run analyses
ACCESS_CODE=

# Optional: max analysis requests per IP per hour (per serverless instance). 0 disables.
RATE_LIMIT_PER_HOUR=30

# Local dev behind a proxy (HK / mainland): Node ignores the system proxy, so Gemini fails with
# "User location is not supported". Put these in .env.development.local and run `npm run dev:proxy`.
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1
# NODE_USE_ENV_PROXY=1

# Optional model overrides (defaults in config/models.ts)
# DEEPSEEK_FAST_MODEL=deepseek-v4-flash
# DEEPSEEK_MAIN_MODEL=deepseek-v4-flash
# DEEPSEEK_DEEP_MODEL=deepseek-v4-pro
# GEMINI_FAST_MODEL=gemini-flash-latest
# GEMINI_MAIN_MODEL=gemini-flash-latest
# GEMINI_DEEP_MODEL=gemini-pro-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
